generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid()) @db.NVarChar(30)
  email        String      @unique @db.NVarChar(254)
  fullName     String?     @db.NVarChar(120)
  passwordHash String      @db.VarChar(60)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  roles        UserRole[]
  sessions     Session[]
}

model Session {
  id               String    @id @default(cuid()) @db.NVarChar(30)
  userId           String    @db.NVarChar(30)
  refreshTokenHash String    @unique @db.Char(64)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model Role {
  id          String           @id @default(cuid()) @db.NVarChar(30)
  name        String           @unique @db.NVarChar(50)
  description String?          @db.NVarChar(300)
  createdAt   DateTime         @default(now())
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid()) @db.NVarChar(30)
  key         String           @unique @db.NVarChar(150)
  description String?          @db.NVarChar(300)
  roles       RolePermission[]
}

model UserRole {
  userId     String   @db.NVarChar(30)
  roleId     String   @db.NVarChar(30)
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String   @db.NVarChar(30)
  permissionId String   @db.NVarChar(30)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}